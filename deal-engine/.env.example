# =============================================================================
# Deal Engine configuration — COPY THIS FILE TO .env AND FILL IN REAL VALUES
# =============================================================================
# NEVER put real secrets in this file. This file (.env.example) is committed to
# git. Your real keys go in .env, which is git-ignored. See README.md.
# =============================================================================

# --- Gmail (OAuth2) ----------------------------------------------------------
# Generate a refresh token via the OAuth2 Playground (see README).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
SENDER_EMAIL=you@example.com

# Human-readable sender identity used in the CASL-compliant email footer.
SENDER_NAME=Your Name
SENDER_COMPANY=Your Company
SENDER_MAILING_ADDRESS=123 Example St, City, Province, Postal Code
UNSUBSCRIBE_EMAIL=unsubscribe@example.com

# --- Apollo ------------------------------------------------------------------
APOLLO_API_KEY=your-apollo-api-key

# --- Anthropic Claude --------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Semrush -----------------------------------------------------------------
SEMRUSH_API_KEY=your-semrush-api-key

# --- ScrapeGraphAI -----------------------------------------------------------
SCRAPEGRAPHAI_API_KEY=your-scrapegraphai-api-key

# --- ImprovMX ----------------------------------------------------------------
IMPROVMX_API_KEY=your-improvmx-api-key

# --- Google Maps -------------------------------------------------------------
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Runtime tuning ----------------------------------------------------------
# Number of drafts to create per run.
DRAFTS_PER_RUN=2
# How many prospects to pull from Apollo per run (fetch extra to allow filtering).
PROSPECTS_PER_RUN=10
# Cron schedule (default: every 3 hours). Standard 5-field cron syntax.
CRON_SCHEDULE=0 */3 * * *
